{
  // Route topology: one authored diagram per file. See
  // docs/dungeon-builder/ROUTE_TOPOLOGY_AUTHORING.md for the schema and the
  // rule list. Check a draft with Tools > Dungeon Lab > Validate Topologies.
  "id": "atrium-ring",
  "displayName": "Atrium Ring",
  "plannerVersion": "atrium-ring-v4",
  "deprecated": true,
  "weight": 0,

  // Lattice column x1 is deliberately empty: it is the atrium void the ring
  // gallery looks across, and it is the vista lane J..M -> D..G.
  "map": [
    "M  .  G  H  .",
    "L  .  F  I  A",
    "K  .  E  .  B",
    "J  .  D  .  C"
  ],

  "spatial": {
    // Was a fixed 7-cell column pitch under the old baseline settings, which
    // only worked because that path also forced small rooms. On the profile's
    // own room sizes a lane two under the pitch puts adjacent rooms wall to
    // wall, so the minimum is the pitch itself and only the maximum moves.
    "columnGapDeltaCells": { "maxDelta": 4 },
    "rowGapDeltaCells": { "maxDelta": 4 },

    // This graph declares no overlook pairs, so it asks for no tier seams.
    // The profile's default of 2 would throw for want of eligible candidates.
    "tierSeamCount": 0
  },

  "nodes": {
    "A": ["atrium-arrival",     "arrival",           "arrival",      0,  { "main": 0 }],
    "B": ["atrium-threshold",   "connector",         "compression",  0,  { "main": 1 }],
    "C": ["outer-approach",     "processional-hall", "approach",     4,  { "main": 2 }],
    "D": ["ring-entry",         "junction",          "choice",       4,  { "main": 3 }],
    "E": ["atrium-landmark",    "landmark",          "landmark",     4,  { "main": 4 }],
    "F": ["ring-ascent",        "connector",         "ascent",       8,  { "main": 5 }],
    "G": ["ring-rejoin",        "junction",          "rejoin",       16, { "main": 6 }],
    "H": ["upper-approach",     "processional-hall", "approach",     20, { "main": 7 }],
    "I": ["atrium-culmination", "culmination",       "culmination",  24, { "main": 8 }],
    "J": ["lower-ring-gallery", "connector",         "branch",       8,  { "branch": 0 }],
    "K": ["ring-overlook",      "overlook",          "reveal",       8,  { "branch": 1 }],
    "L": ["far-ring-gallery",   "optional-room",     "reward",       12, { "branch": 2 }],
    "M": ["upper-ring-gallery", "connector",         "return",       16, { "branch": 3 }]
  },

  "edges": [
    ["A", "B", "LevelCorridor"],
    ["B", "C", "Stair"],
    ["C", "D", "LevelCorridor"],
    ["D", "E", "LevelCorridor"],
    ["E", "F", "Stair"],
    ["F", "G", "Stairwell"],
    ["G", "H", "Stair"],
    ["H", "I", "Stair"],
    ["D", "J", "Bridge"],
    ["J", "K", "LevelCorridor"],
    ["K", "L", "Stair"],
    ["L", "M", "Stair"],
    ["M", "G", "LevelCorridor"]
  ],

  "slots": [
    { "id": "required-compression", "at": "B", "entry": "A-B", "exit": "B-C" },
    { "id": "required-landmark",    "at": "E", "entry": "D-E", "exit": "E-F",
      "orientation": "vista-source-to-target" },
    { "id": "required-return",      "at": "M", "entry": "L-M", "exit": "M-G" }
  ],

  "vista": { "id": "ring-overlook-to-atrium-landmark", "from": "K", "to": "E", "minVoidCells": 3 },

  "overlooks": [],

  "anchors": { "bottom": "A", "top": "I" },
  "allowGenericRoomWings": false
}
