{
  // Three separate rooms change storeys on the critical route. Their upper
  // exits braid back into the main climb and the return loop instead of
  // concentrating all vertical architecture in one landmark.
  "id": "vertical-braid",
  "displayName": "Vertical Braid",
  "plannerVersion": "vertical-braid-v1",
  "weight": 1,

  "map": [
    ".  I  .  .",
    "M  H  G  F",
    "L  K  J  E",
    "A  B  C  D"
  ],

  "spatial": {
    "columnGapDeltaCells": { "maxDelta": 4 },
    "rowGapDeltaCells": { "maxDelta": 4 }
  },

  "nodes": {
    "A": ["braid-arrival",       "arrival",           "arrival",              0,  { "main": 0 }],
    "B": ["switchback-gate",     "connector",         "vertical-compression", 0,  { "main": 1 }, { "layers": { "upper": 4 } }],
    "C": ["lower-choice",        "junction",          "choice",               4,  { "main": 2 }],
    "D": ["court-reveal",        "grand-room",        "reveal",               4,  { "main": 3 }],
    "E": ["hanging-court",       "landmark",          "hanging-court",        8,  { "main": 4 }, { "layers": { "upper": 4 } }],
    "F": ["upper-crossing",      "connector",         "ascent",              12, { "main": 5 }],
    "G": ["braided-approach",    "processional-hall", "approach",            16, { "main": 6 }],
    "H": ["high-rejoin",         "return-hall",       "rejoin",              20, { "main": 7 }],
    "I": ["braid-culmination",   "culmination",       "culmination",         24, { "main": 8 }],
    "J": ["court-overlook",      "overlook",          "reveal",              12, { "branch": 0 }],
    "K": ["branch-passage",      "connector",         "branch",              12, { "branch": 1 }],
    "L": ["branch-reward",       "optional-room",     "reward",              16, { "branch": 2 }],
    "M": ["spiral-return",       "return-hall",       "layered-return",      20, { "branch": 3 }, { "layers": { "upper": 4 } }]
  },

  "edges": [
    ["A", "B", "LevelCorridor"],
    ["B", "C", "LevelCorridor", { "fromLayer": "upper" }],
    ["C", "D", "LevelCorridor"],
    ["D", "E", "Stair"],
    ["E", "F", "LevelCorridor", { "fromLayer": "upper" }],
    ["F", "G", "Stairwell"],
    ["G", "H", "Stair"],
    ["H", "I", "Stair"],
    ["C", "J", "Bridge"],
    ["J", "K", "LevelCorridor"],
    ["K", "L", "Stair"],
    ["L", "M", "Stair"],
    ["M", "H", "Stair", { "fromLayer": "upper" }]
  ],

  "slots": [
    { "id": "required-compression", "at": "B", "entry": "A-B", "exit": "B-C", "layers": { "upper": "upper" } },
    { "id": "required-landmark",    "at": "E", "entry": "D-E", "exit": "E-F", "layers": { "upper": "upper" } },
    { "id": "required-return",      "at": "M", "entry": "L-M", "exit": "M-H", "layers": { "upper": "upper" } }
  ],

  "vista": { "id": "braid-overlook-to-hanging-court", "from": "J", "to": "E", "minVoidCells": 3 },
  "overlooks": [["G", "J"], ["H", "K"]],
  "anchors": { "bottom": "A", "top": "I" },
  "allowGenericRoomWings": true
}
