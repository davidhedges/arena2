  "id": "twin-wing-keep",
  "displayName": "Twin-Wing Keep",
  "plannerVersion": "twin-wing-keep-v3",

  // A long keep spine with a wing above and a wing below, both forking off the
  // hub C and rejoining at F.
  "map": [
    ".  .  H  .  I  J  .",
    "A  B  C  D  E  F  G",
    ".  .  K  .  L  M  ."
  ],

  "spatial": {
    "settings": "baseline",
    // Per-lane gaps: this topology was authored in absolute cells with unequal
    // spacing, which is why its lattice is non-uniform. One entry per gap
    // between adjacent lanes, so length == lane count - 1.
    "columnGapCells": [6, 5, 6, 8, 8, 9],
    "rowGapCells": [9, 10]
  },

  "nodes": {
    "A": ["keep-arrival",     "arrival",       "arrival",      0,  { "main": 0 }],
    "B": ["keep-threshold",   "connector",     "compression",  0,  { "main": 1 }],
    "C": ["wing-hub",         "junction",      "choice",       0,  { "main": 2 }],
    "D": ["keep-crossing",    "connector",     "approach",     0,  { "main": 3 }],
    "E": ["keep-landmark",    "landmark",      "landmark",     8,  { "main": 4 }],
    "F": ["wing-rejoin",      "junction",      "rejoin",       16, { "main": 5 }],
    "G": ["keep-culmination", "culmination",   "culmination",  24, { "main": 6 }],
    "H": ["wing-a-entry",     "connector",     "branch",       8,  { "branch": 0 }],
    "I": ["wing-overlook",    "overlook",      "reveal",       12, { "branch": 1 }],
    "J": ["wing-a-return",    "connector",     "return",       16, { "branch": 2 }],
    "K": ["wing-b-entry",     "connector",     "branch",       4,  { "branch": 3 }],
    "L": ["wing-b-reward",    "optional-room", "reward",       8,  { "branch": 4 }],
    "M": ["wing-b-return",    "connector",     "return",       12, { "branch": 5 }]
  },

  "edges": [
    ["A", "B", "LevelCorridor", "main-0-1"],
    ["B", "C", "LevelCorridor", "main-1-2"],
    ["C", "D", "LevelCorridor", "main-2-3"],
    ["D", "E", "Stair",         "main-3-4"],
    ["E", "F", "Stairwell",     "main-4-5"],
    ["F", "G", "Stair",         "main-5-6"],
    ["C", "H", "Bridge",        "wing-a-2-7"],
    ["H", "I", "Stair",         "wing-a-7-8"],
    ["I", "J", "Stair",         "wing-a-8-9"],
    ["J", "F", "LevelCorridor", "wing-a-rejoin-9-5"],
    ["C", "K", "Stair",         "wing-b-2-10"],
    ["K", "L", "Stair",         "wing-b-10-11"],
    ["L", "M", "Stair",         "wing-b-11-12"],
    ["M", "F", "Bridge",        "wing-b-rejoin-12-5"]
  ],

  "slots": [
    { "id": "required-compression", "at": "B", "entry": "main-0-1",      "exit": "main-1-2" },
    { "id": "required-landmark",    "at": "E", "entry": "main-3-4",      "exit": "main-4-5",
      "orientation": "vista-source-to-target" },
    { "id": "required-return",      "at": "M", "entry": "wing-b-11-12",  "exit": "wing-b-rejoin-12-5" }
  ],

  "vista": { "id": "wing-overlook-to-keep-landmark", "from": "I", "to": "E", "minVoidCells": 3 },

  "overlooks": [],

  "anchors": { "bottom": "A", "top": "G" },
