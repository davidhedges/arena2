{
  // Route topology: one authored diagram per file. See
  // docs/dungeon-builder/ROUTE_TOPOLOGY_AUTHORING.md for the schema and the
  // rule list. Check a draft with Tools > Dungeon Lab > Validate Topologies.
  "id": "twin-wing-keep",
  "displayName": "Twin-Wing Keep",
  "plannerVersion": "twin-wing-keep-v4",
  "weight": 1,

  // A long keep spine with a wing above and a wing below, both forking off the
  // hub C and rejoining at F.
  "map": [
    ".  .  H  .  I  J  .",
    "A  B  C  D  E  F  G",
    ".  .  K  .  L  M  ."
  ],

  "spatial": {
    // Seven lattice columns is the constraint that shapes everything else here.
    // At the profile's 9-cell pitch the six gaps alone would span 54 cells and
    // the plan would not fit 52 in any orientation, so the columns keep their
    // authored, deliberately tight spacing and are FIXED: no rubber sheet.
    "columnGapCells": [6, 5, 6, 8, 8, 9],

    // Three rows, on the other hand, leave the depth axis plenty of room.
    "rowGapCells": [{ "min": 9, "max": 14 }, { "min": 10, "max": 15 }],

    // A 5-cell column lane cannot host the profile's 6-8 cell rooms: adjacent
    // rooms would overlap on every draw and exhaust room inflation. This
    // topology therefore declares its own, narrower sizes. The override is the
    // point of the mechanism - it is visible in the data, with a reason, rather
    // than hidden in a second settings table the profile never reaches.
    "roomSizes": {
      "terminal":  [5, 5, 7, 7],
      "hall":      [5, 5, 5, 6],
      "connector": [4, 5, 5, 5]
    },

    // No overlook pairs are declared, so no tier seams are requested.
    "tierSeamCount": 0
  },

  "nodes": {
    "A": ["keep-arrival",     "arrival",       "arrival",      0,  { "main": 0 }],
    "B": ["keep-threshold",   "connector",     "compression",  0,  { "main": 1 }],
    "C": ["wing-hub",         "junction",      "choice",       0,  { "main": 2 }],
    "D": ["keep-crossing",    "connector",     "approach",     0,  { "main": 3 }],
    "E": ["keep-landmark",    "landmark",      "landmark",     8,  { "main": 4 }],
    "F": ["wing-rejoin",      "junction",      "rejoin",       16, { "main": 5 }],
    "G": ["keep-culmination", "culmination",   "culmination",  24, { "main": 6 }],
    "H": ["wing-a-entry",     "connector",     "branch",       8,  { "branch": 0 }],
    "I": ["wing-overlook",    "overlook",      "reveal",       12, { "branch": 1 }],
    "J": ["wing-a-return",    "connector",     "return",       16, { "branch": 2 }],
    "K": ["wing-b-entry",     "connector",     "branch",       4,  { "branch": 3 }],
    "L": ["wing-b-reward",    "optional-room", "reward",       8,  { "branch": 4 }],
    "M": ["wing-b-return",    "connector",     "return",       12, { "branch": 5 }]
  },

  "edges": [
    ["A", "B", "LevelCorridor"],
    ["B", "C", "LevelCorridor"],
    ["C", "D", "LevelCorridor"],
    ["D", "E", "Stair"],
    ["E", "F", "Stairwell"],
    ["F", "G", "Stair"],
    ["C", "H", "Bridge"],
    ["H", "I", "Stair"],
    ["I", "J", "Stair"],
    ["J", "F", "LevelCorridor"],
    ["C", "K", "Stair"],
    ["K", "L", "Stair"],
    ["L", "M", "Stair"],
    ["M", "F", "Bridge"]
  ],

  "slots": [
    { "id": "required-compression", "at": "B", "entry": "A-B", "exit": "B-C" },
    { "id": "required-landmark",    "at": "E", "entry": "D-E", "exit": "E-F",
      "orientation": "vista-source-to-target" },
    { "id": "required-return",      "at": "M", "entry": "L-M", "exit": "M-F" }
  ],

  "vista": { "id": "wing-overlook-to-keep-landmark", "from": "I", "to": "E", "minVoidCells": 3 },

  "overlooks": [],

  "anchors": { "bottom": "A", "top": "G" },
  "allowGenericRoomWings": false
}
