/* SystemMenu.uss — screen spec. Structural components come from ArenaKit.uss;
 * this file only sets screen layout. Twin: docs/ui-prototypes/system-menu/. */

@import url("ArenaKit.uss");

.system-menu {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: none;
    align-items: center;
    justify-content: center;
    -unity-font-definition: url("/Assets/Arena/Content/UI/Fonts/Alegreya.ttf");
}

.system-menu.is-open {
    display: flex;
}

/* Height = the original 442px shell plus three additional 46px setting rows. */
.system-menu .menu-window {
    width: 400px;
    height: 580px;
}

.window-content {
    width: 100%;
    padding-top: 18px;
    padding-left: 30px;
    padding-right: 30px;
    padding-bottom: 30px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
}

.resume-button {
    flex-shrink: 0;
}

/* Inset so the plate clears the window's bottom corner pieces (56px reach). */
.quit-button {
    margin-top: 8px;
    margin-left: 30px;
    margin-right: 30px;
    flex-shrink: 0;
}

/* Volume value readout, right of the slider. */
.volume-value {
    margin: 0;
    padding: 0;
    width: 48px;
    margin-left: 10px;
    font-size: var(--arena-font-small);
    color: var(--arena-text);
    -unity-text-align: middle-right;
    flex-shrink: 0;
}
