/* SurvivalShop.uss — translated from docs/ui-prototypes/survival-shop. */

@import url("ArenaKit.uss");

.survival-shop {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: none;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    -unity-font-definition: url("/Assets/Arena/Content/UI/Fonts/Alegreya.ttf");
}

.survival-shop.is-open {
    display: flex;
}

.shop-window {
    width: 88%;
    max-width: 1120px;
    height: 78%;
    max-height: 720px;
}

.shop-content {
    width: 100%;
    padding-top: 24px;
    padding-left: 48px;
    padding-right: 48px;
    padding-bottom: 38px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    min-height: 0;
    overflow: hidden;
}

.shop-summary {
    width: 100%;
    height: 72px;
    display: flex;
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    overflow: hidden;
}

.summary-copy {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
    overflow: hidden;
}

.round-label {
    color: var(--arena-ember-bright);
    -unity-font-definition: url("/Assets/Arena/Content/UI/Fonts/Cinzel.ttf");
    font-size: 24px;
    letter-spacing: 3px;
    white-space: normal;
    overflow: hidden;
}

.shop-hint {
    margin-top: 6px;
    color: var(--arena-text-muted);
    font-size: 18px;
    white-space: normal;
    overflow: hidden;
}

.gold-balance {
    width: 230px;
    color: var(--arena-ember-bright);
    -unity-font-definition: url("/Assets/Arena/Content/UI/Fonts/Cinzel.ttf");
    font-size: 25px;
    letter-spacing: 2px;
    -unity-text-align: middle-right;
    flex-shrink: 0;
}

.shop-content .section-rule {
    width: 100%;
    margin-bottom: 18px;
    flex-shrink: 0;
}

.offer-scroll {
    width: 100%;
    min-height: 0;
    margin-bottom: 12px;
    flex-grow: 1;
    overflow: hidden;
}

.offer-scroll .unity-scroll-view__content-viewport {
    overflow: hidden;
}

.offer-scroll .unity-scroll-view__content-container {
    width: 100%;
}

.offer-scroll .unity-scroller--horizontal {
    display: none;
}

.offer-grid {
    width: 100%;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    flex-grow: 0;
    flex-shrink: 0;
    align-content: flex-start;
}

.offer-card {
    width: 280px;
    height: 150px;
    margin-right: 15px;
    margin-bottom: 15px;
    padding-top: 14px;
    padding-left: 18px;
    padding-right: 18px;
    padding-bottom: 14px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    background-color: rgba(16, 20, 22, 0.96);
    border-width: 1px;
    border-color: rgba(151, 118, 63, 0.62);
    color: var(--arena-text);
    -unity-text-align: upper-left;
    overflow: hidden;
    flex-shrink: 0;
}

.offer-card:hover,
.offer-card.is-selected {
    border-color: var(--arena-ember-bright);
    background-color: rgba(47, 39, 25, 0.96);
}

.offer-card.is-purchased {
    opacity: 0.48;
}

.offer-kind {
    color: var(--arena-text-muted);
    font-size: 13px;
    letter-spacing: 2px;
    white-space: normal;
    overflow: hidden;
    max-height: 34px;
}

.offer-name {
    margin-top: 10px;
    color: var(--arena-text);
    -unity-font-definition: url("/Assets/Arena/Content/UI/Fonts/Cinzel.ttf");
    font-size: 19px;
    letter-spacing: 1px;
    -unity-text-align: middle-left;
    white-space: normal;
    overflow: hidden;
    max-height: 46px;
}

.offer-detail {
    margin-top: 5px;
    color: var(--arena-text-muted);
    font-size: 15px;
    -unity-text-align: middle-left;
    white-space: normal;
    overflow: hidden;
    max-height: 38px;
}

.offer-price {
    margin-top: auto;
    color: var(--arena-ember-bright);
    -unity-font-definition: url("/Assets/Arena/Content/UI/Fonts/Cinzel.ttf");
    font-size: 16px;
    letter-spacing: 1px;
    white-space: nowrap;
    overflow: hidden;
}

.shop-footer {
    width: 100%;
    height: 62px;
    display: flex;
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    overflow: hidden;
}

.footer-note {
    color: var(--arena-text-muted);
    font-size: 16px;
    flex-grow: 1;
    flex-shrink: 1;
    padding-right: 20px;
    white-space: normal;
    overflow: hidden;
}

.ready-button {
    width: 260px;
    flex-shrink: 0;
}
