/* Build overview, trait strip, and a flexible editor with a pinned save action. */
.disciplines-screen {
    display: none;
    padding: 120px 42px 28px;
    background-color: var(--hub-ink);
}

.disciplines-screen.is-open { display: flex; }

.screen-background {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    background-image: url("/Assets/Arena/Resources/Hub/Hub_background.png");
    -unity-background-scale-mode: scale-and-crop;
    opacity: 0.12;
}

.screen-veil, .screen-vignette { display: none; }

.build-heading {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24px;
    flex-shrink: 0;
}

.build-heading-copy { flex-grow: 1; min-width: 0; }

.allocation-panel { flex-direction: row; align-items: center; }

.allocation-item {
    min-width: 160px;
    align-items: center;
    padding: 10px 20px;
}

.allocation-value {
    -unity-font-definition: url("/Assets/Arena/Content/UI/Fonts/Cinzel.ttf");
    font-size: 27px;
    color: var(--hub-brass-bright);
}

.allocation-label {
    margin-top: 6px;
    color: var(--hub-dim);
    font-size: 10px;
    letter-spacing: 1.2px;
}

.allocation-divider {
    width: 1px;
    height: 36px;
    background-color: var(--hub-line);
}

.loadout-overview { padding: 18px 20px 20px; flex-shrink: 0; }

.overview-heading {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
}

.overview-title, .trait-title, .save-title {
    margin-top: 4px;
    -unity-font-definition: url("/Assets/Arena/Content/UI/Fonts/Cinzel.ttf");
    font-size: 21px;
    color: var(--hub-text);
}

.overview-help {
    font-size: 10px;
    color: var(--hub-dim);
    letter-spacing: 1.4px;
}

.discipline-cards { flex-direction: row; align-items: stretch; }

.arena-hub-ui .discipline-summary-card, .arena-hub-ui .add-discipline-card {
    min-width: 0;
    height: 156px;
    flex-basis: 0;
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: 14px;
    padding: 14px 16px;
    align-items: stretch;
    justify-content: flex-start;
    background-color: #10181C;
    border-color: var(--hub-line-soft);
    border-top-width: 2px;
}

.arena-hub-ui .discipline-summary-card.is-last, .arena-hub-ui .add-discipline-card.is-last { margin-right: 0; }

.arena-hub-ui .discipline-summary-card.is-selected {
    background-color: #202B2F;
    border-right-color: #697372;
    border-bottom-color: #697372;
    border-left-color: #697372;
}

.summary-identity {
    height: 54px;
    flex-direction: row;
    align-items: center;
}

.summary-slot {
    width: 26px;
    height: 26px;
    margin-right: 12px;
    align-items: center;
    justify-content: center;
    border-width: 1px;
    border-radius: 2px;
    flex-shrink: 0;
}

.summary-slot-number { font-size: 12px; }

.summary-discipline-icon {
    width: 48px;
    height: 48px;
    margin-right: 14px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.summary-copy { min-width: 0; flex-grow: 1; }

.summary-discipline-name {
    -unity-font-definition: url("/Assets/Arena/Content/UI/Fonts/Cinzel.ttf");
    font-size: 19px;
    white-space: normal;
}

.summary-specialization-name {
    margin-top: 5px;
    font-size: 11px;
    letter-spacing: 1px;
    white-space: normal;
}

.starting-chip {
    align-self: flex-start;
    color: var(--hub-brass);
    font-size: 9px;
    padding-top: 4px;
    margin-left: 6px;
}

.summary-feature-heading {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 12px;
    margin-bottom: 8px;
}

.summary-feature-label, .summary-feature-count {
    color: var(--hub-dim);
    font-size: 9px;
    letter-spacing: 1px;
}

.summary-feature-row {
    height: 34px;
    flex-direction: row;
    align-items: center;
}

.summary-feature-icon, .summary-feature-overflow {
    width: 32px;
    height: 32px;
    margin-right: 5px;
    flex-shrink: 0;
    border-width: 1px;
    border-color: var(--hub-line);
    background-color: var(--hub-ink);
    -unity-background-scale-mode: scale-to-fit;
}

.summary-feature-overflow {
    color: var(--hub-brass);
    font-size: 11px;
    -unity-text-align: middle-center;
}

.summary-feature-empty { color: var(--hub-dim); font-size: 12px; }

.arena-hub-ui .add-discipline-card {
    align-items: center;
    justify-content: center;
    border-top-width: 1px;
}

.empty-slot {
    position: absolute;
    top: 14px;
    left: 16px;
}

.empty-slot-number { font-size: 12px; color: var(--hub-dim); }

.add-discipline-plus { font-size: 36px; color: var(--hub-brass); }

.add-discipline-title {
    font-size: 11px;
    letter-spacing: 1px;
    margin-top: 6px;
}

.add-discipline-copy {
    color: var(--hub-dim);
    font-size: 12px;
    margin-top: 6px;
}

.trait-strip {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-top: 14px;
    padding: 14px 20px;
}

.trait-heading { width: 190px; flex-shrink: 0; }

.trait-options {
    flex-grow: 1;
    min-width: 0;
    flex-direction: row;
    align-items: center;
}

.arena-hub-ui .trait-button {
    min-width: 0;
    max-width: 550px;
    flex-grow: 1;
    margin-right: 18px;
    padding: 10px 16px;
    flex-direction: row;
    align-items: center;
}

.arena-hub-ui .trait-button.is-selected { border-color: #677966; background-color: #232E28; }

.trait-sigil {
    width: 38px;
    height: 38px;
    margin-right: 14px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-width: 1px;
    border-color: #59605A;
    border-radius: 20px;
    color: var(--hub-brass-bright);
}

.trait-sigil-glyph { font-size: 23px; }

.trait-copy { min-width: 0; flex-grow: 1; }

.trait-name { font-size: 12px; letter-spacing: 1px; }

.trait-description {
    margin-top: 4px;
    font-size: 12px;
    color: var(--hub-muted);
    white-space: normal;
}

.trait-state {
    margin-left: 20px;
    color: var(--hub-dim);
    font-size: 9px;
}

.trait-button.is-selected .trait-state { color: var(--hub-success); }

.trait-capacity {
    margin-left: 10px;
    flex-grow: 1;
    color: var(--hub-muted);
    font-size: 12px;
    -unity-text-align: middle-right;
}

.configuration-shell {
    min-height: 0;
    flex-basis: 0;
    flex-grow: 1;
    margin-top: 14px;
    flex-direction: row;
}

.specialization-editor {
    min-width: 0;
    flex-basis: 0;
    flex-grow: 1;
    margin-right: 18px;
}

.discipline-card { padding: 20px 22px 24px; }

.discipline-card-heading {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 16px;
    border-bottom-width: 1px;
    border-bottom-color: var(--hub-line-soft);
}

.discipline-identity {
    flex-direction: row;
    align-items: center;
    min-width: 0;
    flex-grow: 1;
}

.discipline-emblem {
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    margin-right: 16px;
    border-width: 1px;
    -unity-background-scale-mode: scale-to-fit;
}

.discipline-copy { min-width: 0; }

.card-kicker {
    color: var(--hub-dim);
    font-size: 10px;
    letter-spacing: 1px;
}

.discipline-name {
    -unity-font-definition: url("/Assets/Arena/Content/UI/Fonts/Cinzel.ttf");
    font-size: 23px;
    margin-top: 4px;
}

.discipline-controls {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-end;
}

.arena-hub-ui .card-control {
    height: 32px;
    padding-left: 12px;
    padding-right: 12px;
    margin-left: 8px;
    font-size: 10px;
    color: var(--hub-muted);
}

.arena-hub-ui .card-control.is-selected { color: var(--hub-brass); border-color: #62604F; }

.arena-hub-ui .remove-control { color: #C69589; }

.feature-help {
    margin-top: 14px;
    font-size: 13px;
    color: var(--hub-muted);
    white-space: normal;
}

.ability-section-heading {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 20px;
    margin-bottom: 12px;
}

.ability-section-title {
    font-size: 10px;
    letter-spacing: 1.5px;
    color: var(--hub-brass);
}

.ability-section-counter { font-size: 10px; color: var(--hub-dim); }

.active-slot-grid { flex-direction: row; flex-wrap: wrap; }

.arena-hub-ui .ability-cell {
    width: 148px;
    height: 160px;
    margin-right: 10px;
    margin-bottom: 10px;
    padding: 10px 8px;
    align-items: center;
    justify-content: flex-start;
    background-color: #121C20;
    border-color: var(--hub-line-soft);
}

.arena-hub-ui .ability-cell.is-filled { background-color: var(--hub-selected); border-color: #A28F6E; }

.ability-icon {
    width: 60px;
    height: 60px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.ability-kind {
    color: var(--hub-dim);
    font-size: 9px;
    letter-spacing: 1px;
    margin-top: 8px;
}

.ability-name {
    width: 128px;
    min-height: 30px;
    margin-top: 4px;
    font-size: 12px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.ability-state {
    margin-top: 5px;
    font-size: 9px;
    letter-spacing: 1px;
    color: var(--hub-dim);
}

.ability-cell.is-filled .ability-state { color: var(--hub-brass-bright); }

.order-row {
    width: 100%;
    max-width: 540px;
    min-height: 38px;
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
    border-bottom-width: 1px;
    border-bottom-color: var(--hub-line-soft);
}

.order-number {
    width: 32px;
    font-size: 12px;
    color: var(--hub-brass);
}

.order-name {
    flex-grow: 1;
    min-width: 0;
    font-size: 13px;
    color: var(--hub-muted);
}

.arena-hub-ui .order-control {
    width: 34px;
    height: 30px;
    margin-left: 6px;
    color: var(--hub-muted);
}

.build-footer {
    width: 340px;
    flex-shrink: 0;
    padding: 22px;
}

.save-heading {
    padding-bottom: 16px;
    border-bottom-width: 1px;
    border-bottom-color: var(--hub-line-soft);
    flex-shrink: 0;
}

.save-summary { flex-grow: 1; margin-top: 6px; }

.save-summary-row {
    min-height: 56px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: var(--hub-line-soft);
}

.save-summary-slot {
    width: 24px;
    height: 24px;
    margin-right: 10px;
    color: var(--hub-brass);
    font-size: 12px;
    -unity-text-align: middle-center;
    border-width: 1px;
    border-color: var(--hub-line);
}

.save-summary-copy { flex-grow: 1; min-width: 0; }

.save-summary-name { font-size: 12px; white-space: normal; }

.save-summary-parent {
    font-size: 10px;
    margin-top: 4px;
    color: var(--hub-dim);
}

.save-summary-count {
    margin-left: 6px;
    color: var(--hub-brass);
    font-size: 9px;
}

.save-summary-totals { padding-top: 12px; padding-bottom: 12px; }

.save-metric {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    min-height: 26px;
}

.save-metric-label { color: var(--hub-dim); font-size: 10px; }

.save-metric-value { color: var(--hub-brass); font-size: 12px; }

.save-status {
    margin-top: 10px;
    margin-bottom: 12px;
    font-size: 12px;
    color: var(--hub-muted);
    white-space: normal;
}

.footer-actions { flex-shrink: 0; }

.empty-editor, .waiting-state {
    min-height: 200px;
    align-items: center;
    justify-content: center;
}

.empty-editor-glyph { color: var(--hub-brass); font-size: 38px; }

.empty-editor-title { margin-top: 12px; font-size: 18px; }

.empty-editor-copy, .waiting-state {
    margin-top: 8px;
    color: var(--hub-muted);
    font-size: 14px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.arena-hub-ui .empty-editor-action {
    height: 42px;
    margin-top: 20px;
    padding: 8px 18px;
    color: var(--hub-brass);
    font-size: 12px;
}

.picker-overlay {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    display: none;
    align-items: center;
    justify-content: center;
}

.picker-overlay.is-open { display: flex; }

.arena-hub-ui .picker-scrim {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    background-color: rgba(3,8,11,0.88);
    border-width: 0;
}

.picker-panel {
    width: 720px;
    max-width: 90%;
    height: 76%;
    padding: 30px;
    background-color: #111B20;
    border-width: 1px;
    border-color: #68706A;
    border-radius: 3px;
}

.picker-heading {
    flex-direction: row;
    justify-content: space-between;
    padding-bottom: 20px;
    border-bottom-width: 1px;
    border-bottom-color: var(--hub-line);
}

.picker-title { -unity-font-definition: url("/Assets/Arena/Content/UI/Fonts/Cinzel.ttf"); font-size: 24px; }

.picker-subtitle {
    max-width: 555px;
    margin-top: 8px;
    font-size: 14px;
    color: var(--hub-muted);
    white-space: normal;
}

.arena-hub-ui .picker-close {
    width: 36px;
    height: 36px;
    font-size: 23px;
}

.picker-options { flex-grow: 1; margin-top: 20px; }

.arena-hub-ui .picker-option {
    min-height: 78px;
    flex-shrink: 0;
    margin-bottom: 8px;
    padding: 12px 16px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
}

.picker-option-icon {
    width: 48px;
    height: 48px;
    margin-right: 18px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.picker-option-copy { min-width: 0; }

.picker-option-copy Label {
    font-size: 14px;
    white-space: normal;
    margin-top: 3px;
}

.picker-option-copy .picker-option-name {
    color: var(--hub-text);
    -unity-text-align: middle-left;
    font-size: 15px;
}

.picker-option-copy .picker-option-meta {
    color: var(--hub-muted);
    -unity-text-align: middle-left;
    font-size: 12px;
}

.save-summary-icon {
    width: 30px;
    height: 30px;
    margin-right: 10px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}
