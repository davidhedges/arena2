/* Arena Disciplines — one-way UI Toolkit translation of the approved browser
 * spec. No card or panel uses the bright corner ornaments rejected in review. */

.disciplines-screen {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: none;
    overflow: hidden;
    color: var(--arena-text);
    -unity-font-definition: url("/Assets/Arena/Content/UI/Fonts/Alegreya.ttf");
}

.disciplines-screen.is-open { display: flex; }

.disciplines-screen Label,
.disciplines-screen Button {
    margin: 0;
    padding: 0;
}

.disciplines-screen Button {
    border-width: 0;
    border-radius: 0;
    background-image: none;
}

.screen-background {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: url("/Assets/Arena/Resources/Hub/Hub_background.png");
    -unity-background-scale-mode: scale-and-crop;
}

.screen-veil {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(4, 6, 8, 0.60);
}

.topbar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 96px;
    flex-direction: row;
    align-items: stretch;
    background-color: rgba(5, 7, 9, 0.96);
    border-bottom-width: 1px;
    border-bottom-color: rgba(199, 163, 94, 0.50);
}

.brand-block {
    width: 264px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    padding-left: 34px;
    background-color: rgba(0, 0, 0, 0);
    border-right-width: 1px;
    border-right-color: rgba(231, 225, 211, 0.10);
}

.brand-mark {
    position: relative;
    width: 52px;
    height: 52px;
    margin-right: 16px;
    flex-shrink: 0;
}

.brand-diamond {
    position: absolute;
    top: 7px;
    left: 7px;
    width: 38px;
    height: 38px;
    rotate: 45deg;
    border-width: 1px;
    border-color: var(--arena-ember-bright);
}

.brand-spear {
    position: absolute;
    top: 25px;
    left: 6px;
    width: 40px;
    height: 2px;
    background-color: var(--arena-gold-text);
    transform-origin: center;
}

.brand-spear--one { rotate: 45deg; }
.brand-spear--two { rotate: -45deg; }

.brand-word {
    color: var(--arena-text);
    -unity-font-definition: url("/Assets/Arena/Content/UI/Fonts/Cinzel.ttf");
    font-size: 25px;
    letter-spacing: 5px;
}

.primary-nav {
    height: 100%;
    flex-direction: row;
    flex-grow: 1;
    align-items: stretch;
    justify-content: center;
}

.nav-item {
    position: relative;
    height: 100%;
    min-width: 128px;
    padding-left: 22px;
    padding-right: 22px;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0);
    color: rgba(231, 225, 211, 0.74);
    -unity-font-definition: url("/Assets/Arena/Content/UI/Fonts/Cinzel.ttf");
    font-size: 13px;
    letter-spacing: 1px;
    border-bottom-width: 2px;
    border-bottom-color: rgba(0, 0, 0, 0);
}

.nav-item:hover {
    color: var(--arena-text);
    background-color: rgba(255, 255, 255, 0.035);
}

.nav-item.is-active {
    color: var(--arena-gold-text);
    background-color: rgba(197, 143, 42, 0.08);
    border-bottom-color: var(--arena-ember-bright);
}

.nav-gem {
    position: absolute;
    left: 50%;
    bottom: 7px;
    width: 5px;
    height: 5px;
    margin-left: -3px;
    rotate: 45deg;
    background-color: rgba(0, 0, 0, 0);
}

.nav-item.is-active .nav-gem { background-color: var(--arena-ember-bright); }

.topbar-tools {
    height: 100%;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding-right: 22px;
    border-left-width: 1px;
    border-left-color: rgba(231, 225, 211, 0.10);
}

.currency {
    height: 36px;
    min-width: 78px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    color: var(--arena-text);
    font-size: 16px;
}

.currency-gem {
    width: 20px;
    height: 20px;
    margin-right: 7px;
    align-items: center;
    justify-content: center;
    rotate: 45deg;
    border-width: 1px;
}

.currency-glyph {
    rotate: -45deg;
    -unity-font-definition: url("/Assets/Arena/Content/UI/Fonts/Cinzel.ttf");
    font-size: 10px;
}

.currency--gold .currency-gem { color: #F1C75E; border-color: #F1C75E; }
.currency--arcane .currency-gem { color: #AA79DD; border-color: #AA79DD; }

.tool-button {
    width: 54px;
    height: 54px;
    margin-left: 2px;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0);
    color: rgba(221, 205, 172, 0.72);
    border-left-width: 1px;
    border-left-color: rgba(231, 225, 211, 0.10);
}

.tool-button:hover { color: var(--arena-gold-text); background-color: rgba(255, 255, 255, 0.04); }
.tool-people { font-size: 11px; letter-spacing: -1px; }
.tool-envelope { font-size: 25px; }
.tool-cog { font-size: 17px; }

.page-heading {
    position: absolute;
    top: 111px;
    left: 0;
    right: 0;
    height: 74px;
    align-items: center;
}

.heading-kicker,
.section-kicker {
    color: var(--arena-gold-text);
    -unity-font-definition: url("/Assets/Arena/Content/UI/Fonts/Cinzel.ttf");
    font-size: 11px;
    letter-spacing: 3px;
}

.page-title {
    margin-top: 3px;
    color: var(--arena-text);
    -unity-font-definition: url("/Assets/Arena/Content/UI/Fonts/Cinzel.ttf");
    font-size: 27px;
    letter-spacing: 4px;
}

.page-subtitle {
    margin-top: 2px;
    color: var(--arena-text-muted);
    font-size: 14px;
    letter-spacing: 0.5px;
}

.screen-columns {
    position: absolute;
    top: 190px;
    left: 34px;
    right: 34px;
    bottom: 30px;
    flex-direction: row;
    align-items: stretch;
}

.panel-surface {
    position: relative;
    background-color: rgba(8, 10, 12, 0.94);
    border-width: 1px;
    border-top-color: rgba(194, 151, 80, 0.52);
    border-right-color: rgba(194, 151, 80, 0.38);
    border-bottom-color: rgba(194, 151, 80, 0.44);
    border-left-color: rgba(194, 151, 80, 0.38);
}

.left-panel {
    width: 440px;
    flex-shrink: 0;
    padding: 18px 20px;
}

.abilities-panel {
    margin-left: 16px;
    min-width: 0;
    flex-grow: 1;
    padding: 18px 22px 20px 22px;
}

.summary-panel {
    width: 450px;
    margin-left: 16px;
    flex-shrink: 0;
    padding: 20px 28px;
}

.section-heading-row,
.points-heading-row,
.ability-section-heading,
.abilities-heading {
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-between;
}

.section-heading {
    margin-top: 3px;
    color: var(--arena-text);
    -unity-font-definition: url("/Assets/Arena/Content/UI/Fonts/Cinzel.ttf");
    font-size: 17px;
    letter-spacing: 1.8px;
}

.section-limit {
    padding-bottom: 2px;
    color: var(--arena-text-dim);
    -unity-font-definition: url("/Assets/Arena/Content/UI/Fonts/Cinzel.ttf");
    font-size: 10px;
    letter-spacing: 1px;
}

.primary-picker {
    height: 207px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(218, 182, 108, 0.20);
}

.primary-card {
    position: relative;
    height: 132px;
    margin-top: 14px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(38, 28, 15, 0.48);
    border-width: 1px;
    border-color: rgba(228, 179, 74, 0.80);
}

.primary-cycle {
    width: 34px;
    height: 100%;
    flex-shrink: 0;
    background-color: rgba(0, 0, 0, 0);
    color: rgba(217, 181, 106, 0.75);
    font-size: 34px;
}

.primary-cycle:hover { color: #F2CC76; background-color: rgba(228, 179, 74, 0.08); }

.primary-emblem {
    width: 96px;
    height: 96px;
    flex-shrink: 0;
    background-color: #0B0C0F;
    border-width: 1px;
    border-color: rgba(217, 181, 106, 0.58);
    -unity-background-scale-mode: scale-to-fit;
}

.primary-copy {
    min-width: 0;
    padding-left: 15px;
    padding-right: 5px;
    flex-grow: 1;
}

.primary-name,
.summary-primary-name {
    color: #EFD089;
    -unity-font-definition: url("/Assets/Arena/Content/UI/Fonts/Cinzel.ttf");
    font-size: 24px;
    letter-spacing: 2px;
}

.primary-description {
    min-height: 38px;
    margin-top: 4px;
    color: var(--arena-text-muted);
    font-size: 14px;
    white-space: normal;
}

.primary-change-hint {
    margin-top: 5px;
    color: rgba(217, 181, 106, 0.62);
    -unity-font-definition: url("/Assets/Arena/Content/UI/Fonts/Cinzel.ttf");
    font-size: 9px;
    letter-spacing: 1.4px;
}

.secondary-picker {
    height: 293px;
    padding-top: 15px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(218, 182, 108, 0.20);
}

.discipline-grid {
    height: 207px;
    margin-top: 10px;
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
}

.discipline-option {
    position: relative;
    width: 92px;
    height: 96px;
    margin-right: 8px;
    margin-bottom: 8px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(12, 14, 17, 0.92);
    border-width: 1px;
    border-color: rgba(169, 175, 184, 0.25);
}

.discipline-option:hover { background-color: rgba(255, 255, 255, 0.035); }
.discipline-option.is-selected { background-color: rgba(217, 181, 106, 0.08); }
.discipline-option.is-disabled { opacity: 0.43; }

.discipline-option-icon {
    width: 56px;
    height: 56px;
    background-color: #0B0C0F;
    border-width: 1px;
    border-color: rgba(217, 181, 106, 0.24);
    -unity-background-scale-mode: scale-to-fit;
}

.discipline-option-name {
    width: 100%;
    margin-top: 3px;
    overflow: hidden;
    color: var(--arena-text-muted);
    -unity-font-definition: url("/Assets/Arena/Content/UI/Fonts/Cinzel.ttf");
    font-size: 9px;
    letter-spacing: 0.5px;
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.discipline-option.is-selected .discipline-option-name { color: #EFD089; }

.discipline-check,
.ability-check {
    position: absolute;
    display: none;
    align-items: center;
    justify-content: center;
    background-color: #C58F2A;
    color: #171109;
    -unity-font-definition: url("/Assets/Arena/Content/UI/Fonts/Cinzel.ttf");
}

.discipline-check {
    top: 4px;
    right: 4px;
    width: 17px;
    height: 17px;
    font-size: 12px;
}

.discipline-option.is-selected .discipline-check,
.ability-tile.is-selected .ability-check { display: flex; }

.selection-help {
    height: 17px;
    margin-top: -1px;
    overflow: hidden;
    color: var(--arena-text-dim);
    font-size: 12px;
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.selection-help.is-warning { color: #D9A55B; }

.points-panel { padding-top: 15px; }
.points-heading-row { align-items: center; }

.points-remaining { align-items: flex-end; }

.points-remaining-value {
    color: #EDC66C;
    -unity-font-definition: url("/Assets/Arena/Content/UI/Fonts/Cinzel.ttf");
    font-size: 28px;
}

.points-remaining-copy {
    margin-top: -2px;
    color: var(--arena-text-dim);
    -unity-font-definition: url("/Assets/Arena/Content/UI/Fonts/Cinzel.ttf");
    font-size: 8px;
    letter-spacing: 1px;
}

.point-rule {
    position: relative;
    width: 100%;
    height: 3px;
    margin-top: 10px;
    background-color: rgba(231, 225, 211, 0.10);
}

.point-rule-fill {
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    width: 100%;
    background-color: rgba(228, 179, 74, 0.68);
}

.stat-list {
    height: 220px;
    margin-top: 9px;
    flex-direction: column;
}

.stat-row {
    height: 42px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: rgba(231, 225, 211, 0.08);
}

.stat-glyph {
    width: 29px;
    color: #D9A64A;
    -unity-font-definition: url("/Assets/Arena/Content/UI/Fonts/Cinzel.ttf");
    font-size: 18px;
    -unity-text-align: middle-center;
}

.stat-name {
    flex-grow: 1;
    color: #D8C49C;
    -unity-font-definition: url("/Assets/Arena/Content/UI/Fonts/Cinzel.ttf");
    font-size: 12px;
    letter-spacing: 1px;
}

.stat-value {
    width: 30px;
    color: var(--arena-text);
    font-size: 19px;
    -unity-text-align: middle-center;
}

.stat-step {
    width: 30px;
    height: 28px;
    margin-left: 4px;
    align-items: center;
    justify-content: center;
    background-color: rgba(14, 16, 19, 0.92);
    color: #D9B56A;
    border-width: 1px;
    border-color: rgba(217, 181, 106, 0.35);
    font-size: 20px;
}

.stat-step:hover { background-color: rgba(197, 143, 42, 0.14); border-color: rgba(228, 179, 74, 0.78); }
.stat-step:disabled { opacity: 0.28; }

.points-footer {
    height: 29px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    color: var(--arena-text-dim);
    -unity-font-definition: url("/Assets/Arena/Content/UI/Fonts/Cinzel.ttf");
    font-size: 10px;
    letter-spacing: 0.6px;
}

.text-button {
    height: 27px;
    padding-left: 10px;
    padding-right: 10px;
    background-color: rgba(0, 0, 0, 0);
    color: rgba(217, 181, 106, 0.75);
    -unity-font-definition: url("/Assets/Arena/Content/UI/Fonts/Cinzel.ttf");
    font-size: 9px;
    letter-spacing: 1px;
    border-width: 1px;
    border-color: rgba(217, 181, 106, 0.28);
}

.text-button:hover { color: #EFD089; border-color: rgba(228, 179, 74, 0.65); }

.abilities-heading {
    height: 54px;
    padding-left: 2px;
    padding-right: 2px;
    padding-bottom: 13px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(218, 182, 108, 0.22);
}

.catalog-source {
    padding-bottom: 2px;
    color: #88A96B;
    -unity-font-definition: url("/Assets/Arena/Content/UI/Fonts/Cinzel.ttf");
    font-size: 9px;
    letter-spacing: 1.1px;
}

.ability-section {
    padding-top: 13px;
    padding-left: 2px;
    padding-right: 2px;
}

.ability-section--primary {
    height: 396px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(218, 182, 108, 0.22);
}

.ability-section--secondary { height: 360px; }

.ability-section-heading {
    height: 46px;
    align-items: flex-start;
}

.ability-heading-title {
    color: #D9B56A;
    -unity-font-definition: url("/Assets/Arena/Content/UI/Fonts/Cinzel.ttf");
    font-size: 13px;
    letter-spacing: 1.3px;
}

.ability-heading-copy {
    margin-top: 2px;
    color: var(--arena-text-dim);
    font-size: 12px;
}

.selection-counter {
    color: #EDC66C;
    -unity-font-definition: url("/Assets/Arena/Content/UI/Fonts/Cinzel.ttf");
    font-size: 14px;
}

.selection-counter.is-incomplete { color: #D46B50; }

.ability-grid {
    overflow: hidden;
}

.ability-grid .unity-scroll-view__content-viewport { overflow: hidden; }

.ability-grid .unity-scroll-view__content-container {
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
}

.ability-grid--primary { height: 324px; }

.ability-tile {
    position: relative;
    width: 137px;
    height: 136px;
    margin-right: 8px;
    margin-bottom: 8px;
    flex-shrink: 0;
    align-items: center;
    background-color: rgba(12, 14, 17, 0.94);
    border-width: 1px;
    border-color: rgba(169, 175, 184, 0.25);
}

.ability-tile:hover { border-color: rgba(217, 181, 106, 0.70); background-color: rgba(255, 255, 255, 0.04); }
.ability-tile.is-selected { border-color: #E4B34A; background-color: rgba(197, 143, 42, 0.10); }

.ability-art {
    width: 96px;
    height: 96px;
    margin-top: 7px;
    flex-shrink: 0;
    background-color: #08090B;
    border-width: 1px;
    border-color: rgba(217, 181, 106, 0.28);
    -unity-background-scale-mode: scale-to-fit;
}

.ability-tile.is-selected .ability-art { border-color: rgba(238, 197, 103, 0.92); }

.ability-name {
    width: 100%;
    margin-top: 5px;
    padding-left: 4px;
    padding-right: 4px;
    overflow: hidden;
    color: var(--arena-text-muted);
    font-size: 12px;
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.ability-tile.is-selected .ability-name { color: #E8D4AA; }

.ability-check {
    top: 5px;
    right: 5px;
    width: 20px;
    height: 20px;
    font-size: 13px;
}

.secondary-ability-groups {
    height: 292px;
    flex-direction: row;
}

.secondary-group {
    min-width: 0;
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: column;
}

.secondary-group--offset { margin-left: 14px; }

.secondary-group-heading {
    height: 32px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: rgba(231, 225, 211, 0.10);
}

.secondary-group-icon {
    width: 24px;
    height: 24px;
    margin-right: 8px;
    background-color: #090A0C;
    border-width: 1px;
    border-color: rgba(217, 181, 106, 0.30);
    -unity-background-scale-mode: scale-to-fit;
}

.secondary-group-name {
    flex-grow: 1;
    -unity-font-definition: url("/Assets/Arena/Content/UI/Fonts/Cinzel.ttf");
    font-size: 11px;
    letter-spacing: 1px;
}

.secondary-group-count {
    color: var(--arena-text-dim);
    -unity-font-definition: url("/Assets/Arena/Content/UI/Fonts/Cinzel.ttf");
    font-size: 9px;
}

.secondary-group-count.is-incomplete { color: #D46B50; }

.ability-grid--secondary { height: 254px; padding-top: 7px; }

.ability-grid--secondary .ability-tile {
    width: 98px;
    height: 106px;
    margin-right: 7px;
    margin-bottom: 7px;
}

.ability-grid--secondary .ability-art { width: 72px; height: 72px; margin-top: 5px; }
.ability-grid--secondary .ability-name { margin-top: 3px; font-size: 10px; }
.ability-grid--secondary .ability-check { top: 3px; right: 3px; width: 17px; height: 17px; font-size: 11px; }

.secondary-empty {
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    color: var(--arena-text-dim);
    border-width: 1px;
    border-color: rgba(231, 225, 211, 0.08);
    font-size: 12px;
}

.summary-heading {
    height: 60px;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: rgba(218, 182, 108, 0.22);
}

.summary-title {
    margin-top: 5px;
    color: var(--arena-text);
    -unity-font-definition: url("/Assets/Arena/Content/UI/Fonts/Cinzel.ttf");
    font-size: 19px;
    letter-spacing: 1.8px;
}

.summary-label {
    color: rgba(217, 181, 106, 0.72);
    -unity-font-definition: url("/Assets/Arena/Content/UI/Fonts/Cinzel.ttf");
    font-size: 10px;
    letter-spacing: 1.8px;
}

.summary-primary {
    height: 130px;
    padding: 13px 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(218, 182, 108, 0.18);
}

.summary-primary-content {
    margin-top: 8px;
    flex-direction: row;
    align-items: center;
}

.summary-primary-emblem {
    width: 70px;
    height: 70px;
    margin-right: 17px;
    flex-shrink: 0;
    background-color: #0B0C0F;
    border-width: 1px;
    border-color: rgba(217, 181, 106, 0.58);
    -unity-background-scale-mode: scale-to-fit;
}

.summary-primary-name { font-size: 22px; }

.summary-primary-kind {
    margin-top: 4px;
    color: var(--arena-text-dim);
    -unity-font-definition: url("/Assets/Arena/Content/UI/Fonts/Cinzel.ttf");
    font-size: 9px;
    letter-spacing: 1px;
}

.summary-secondary {
    height: 120px;
    padding: 12px 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(218, 182, 108, 0.18);
}

.summary-secondary-list {
    height: 82px;
    margin-top: 5px;
    flex-direction: column;
}

.summary-secondary-row {
    height: 39px;
    flex-direction: row;
    align-items: center;
}

.summary-secondary-icon {
    width: 36px;
    height: 36px;
    margin-right: 12px;
    background-color: #090A0C;
    border-width: 1px;
    border-color: rgba(217, 181, 106, 0.28);
    -unity-background-scale-mode: scale-to-fit;
}

.summary-secondary-name {
    flex-grow: 1;
    -unity-font-definition: url("/Assets/Arena/Content/UI/Fonts/Cinzel.ttf");
    font-size: 13px;
    letter-spacing: 1px;
}

.summary-secondary-abilities { color: var(--arena-text-muted); font-size: 12px; }

.summary-secondary-empty {
    height: 78px;
    align-items: center;
    justify-content: center;
    color: var(--arena-text-dim);
    font-size: 13px;
}

.requirements {
    height: 145px;
    padding: 12px 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(218, 182, 108, 0.18);
}

.requirement-list { margin-top: 9px; }

.requirement-row {
    min-height: 31px;
    flex-direction: row;
    align-items: center;
    color: var(--arena-text-muted);
    font-size: 13px;
}

.requirement-icon {
    width: 19px;
    height: 19px;
    margin-right: 10px;
    align-items: center;
    justify-content: center;
    background-color: rgba(126, 151, 91, 0.18);
    color: #A8C27F;
    border-width: 1px;
    border-color: rgba(126, 151, 91, 0.60);
    font-size: 11px;
}

.requirement-row.is-incomplete { color: #D4A28D; }
.requirement-row.is-incomplete .requirement-icon { background-color: rgba(163, 44, 34, 0.14); color: #D87862; border-color: rgba(196, 58, 44, 0.62); }

.summary-totals {
    height: 150px;
    padding: 12px 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(218, 182, 108, 0.18);
}

.summary-row {
    height: 27px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    color: var(--arena-text-muted);
    font-size: 14px;
}

.summary-value {
    color: #E7D0A0;
    -unity-font-definition: url("/Assets/Arena/Content/UI/Fonts/Cinzel.ttf");
    font-size: 13px;
}

.summary-rule {
    height: 1px;
    margin-top: 3px;
    margin-bottom: 4px;
    background-color: rgba(231, 225, 211, 0.10);
}

.summary-row--total { color: var(--arena-text); }
.summary-row--total .summary-value { color: #EDC66C; }

.save-area {
    height: 190px;
    padding: 16px 8px 0 8px;
}

.save-status {
    height: 27px;
    color: #A8C27F;
    font-size: 13px;
    -unity-text-align: middle-center;
}

.save-status.is-incomplete { color: #D4A28D; }

.save-button,
.back-button {
    width: 100%;
    align-items: center;
    justify-content: center;
    -unity-font-definition: url("/Assets/Arena/Content/UI/Fonts/Cinzel.ttf");
    letter-spacing: 1.5px;
}

.save-button {
    height: 54px;
    margin-top: 9px;
    background-color: rgba(136, 91, 19, 0.82);
    color: #F5DDA7;
    border-width: 1px;
    border-color: #D6A745;
    font-size: 16px;
}

.save-button:hover { background-color: rgba(167, 113, 24, 0.90); }
.save-button:disabled { background-color: rgba(34, 35, 36, 0.82); color: rgba(231, 225, 211, 0.35); border-color: rgba(231, 225, 211, 0.15); }

.back-button {
    height: 39px;
    margin-top: 10px;
    background-color: rgba(9, 11, 13, 0.86);
    color: var(--arena-text-muted);
    border-width: 1px;
    border-color: rgba(217, 181, 106, 0.30);
    font-size: 11px;
}

.back-button:hover { color: #E8D4AA; border-color: rgba(217, 181, 106, 0.62); }

.ability-tooltip {
    position: absolute;
    left: 0;
    top: 0;
    width: 270px;
    min-height: 104px;
    padding: 13px 15px;
    display: none;
    background-color: rgba(7, 9, 11, 0.98);
    border-width: 1px;
    border-color: rgba(217, 181, 106, 0.55);
}

.ability-tooltip.is-visible { display: flex; }

.tooltip-name {
    color: #E8C879;
    -unity-font-definition: url("/Assets/Arena/Content/UI/Fonts/Cinzel.ttf");
    font-size: 13px;
    letter-spacing: 1px;
}

.tooltip-meta {
    margin-top: 4px;
    color: var(--arena-text-dim);
    -unity-font-definition: url("/Assets/Arena/Content/UI/Fonts/Cinzel.ttf");
    font-size: 9px;
    letter-spacing: 0.7px;
}

.tooltip-description {
    margin-top: 8px;
    color: var(--arena-text-muted);
    font-size: 13px;
    white-space: normal;
}

.prototype-toast {
    position: absolute;
    left: 50%;
    bottom: 44px;
    width: 620px;
    min-height: 44px;
    margin-left: -310px;
    padding: 11px 22px;
    display: none;
    background-color: rgba(7, 9, 11, 0.96);
    color: var(--arena-text);
    border-width: 1px;
    border-color: rgba(217, 181, 106, 0.50);
    font-size: 14px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.prototype-toast.is-visible { display: flex; }
