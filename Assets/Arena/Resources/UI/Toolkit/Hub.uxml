<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="HubCommon.uss" />
    <Style src="Hub.uss" />

    <ui:VisualElement name="HubScreen" class="arena-hub-ui hub-screen">
        <ui:VisualElement name="HubBackgroundVeil" class="hub-background-veil" picking-mode="Ignore" />
        <ui:VisualElement name="HubFloorShade" class="hub-floor-shade" picking-mode="Ignore" />

        <ui:VisualElement name="PlayerShowcase" class="showcase" />

        <ui:VisualElement name="ProfilePanel" class="profile-panel panel-surface">
            <ui:Label class="section-kicker" text="YOUR CHAMPION" />
            <ui:Label name="PlayerName" class="profile-name" text="Welcome back" />
            <ui:Label class="profile-subtitle" text="Every battle begins with a build." />
            <ui:VisualElement class="section-rule" picking-mode="Ignore" />
            <ui:VisualElement class="profile-loadout-heading"><ui:Label class="section-kicker" text="COMBAT LOADOUT" /><ui:Label class="subtle-label" text="EQUIPPED" /></ui:VisualElement>
                <ui:VisualElement name="LoadoutList" class="loadout-list">
                    <ui:VisualElement name="LoadoutSlot0Row" class="loadout-row">
                        <ui:VisualElement name="LoadoutSlot0Icon" class="loadout-icon" picking-mode="Ignore">
                            <ui:VisualElement name="LoadoutSlot0Art" class="loadout-art" />
                            <ui:Label name="LoadoutSlot0Glyph" class="loadout-glyph" text="D" />
                        </ui:VisualElement>
                        <ui:VisualElement class="loadout-copy">
                            <ui:Label class="loadout-type" text="SLOT 1" />
                            <ui:Label name="LoadoutSlot0Name" class="loadout-name" text="Awaiting loadout" />
                        </ui:VisualElement>
                        <ui:Label class="loadout-index" text="01" />
                    </ui:VisualElement>
                    <ui:VisualElement name="LoadoutSlot1Row" class="loadout-row">
                        <ui:VisualElement name="LoadoutSlot1Icon" class="loadout-icon" picking-mode="Ignore">
                            <ui:VisualElement name="LoadoutSlot1Art" class="loadout-art" />
                            <ui:Label name="LoadoutSlot1Glyph" class="loadout-glyph" text="B" />
                        </ui:VisualElement>
                        <ui:VisualElement class="loadout-copy">
                            <ui:Label class="loadout-type" text="SLOT 2" />
                            <ui:Label name="LoadoutSlot1Name" class="loadout-name" text="—" />
                        </ui:VisualElement>
                        <ui:Label class="loadout-index" text="02" />
                    </ui:VisualElement>
                    <ui:VisualElement name="LoadoutSlot2Row" class="loadout-row">
                        <ui:VisualElement name="LoadoutSlot2Icon" class="loadout-icon" picking-mode="Ignore">
                            <ui:VisualElement name="LoadoutSlot2Art" class="loadout-art" />
                            <ui:Label name="LoadoutSlot2Glyph" class="loadout-glyph" text="S" />
                        </ui:VisualElement>
                        <ui:VisualElement class="loadout-copy">
                            <ui:Label class="loadout-type" text="SLOT 3" />
                            <ui:Label name="LoadoutSlot2Name" class="loadout-name" text="—" />
                        </ui:VisualElement>
                        <ui:Label class="loadout-index" text="03" />
                    </ui:VisualElement>
                </ui:VisualElement>

            <ui:Button name="EditLoadout" class="secondary-button profile-edit" text="CONFIGURE DISCIPLINES   ›" />
            <ui:Button name="EditEquipment" class="text-button" text="MANAGE EQUIPMENT   ›" />
        </ui:VisualElement>

        <ui:VisualElement name="MatchPanel" class="match-panel panel-surface">
            <ui:Label class="section-kicker" text="THE ARENA AWAITS" />
            <ui:Label class="match-title" text="Make your&#10;mark." />
            <ui:Label class="match-subtitle" text="Put your build to the test in a 2v2 skirmish." />
            <ui:VisualElement class="section-rule" picking-mode="Ignore" />
            <ui:Button name="QueueButton" class="queue-summary">
                <ui:VisualElement class="queue-copy" picking-mode="Ignore">
                    <ui:Label class="subtle-label" text="SELECTED MODE" />
                    <ui:Label name="QueueName" class="queue-name" text="UNRANKED" />
                </ui:VisualElement>
                <ui:Label class="queue-tag" text="2V2 · BOTS" picking-mode="Ignore" />
            </ui:Button>
            <ui:Button name="FindMatchButton" class="match-button primary-button">
                <ui:Label name="FindMatchTitle" class="button-title" text="PLAY 2V2" picking-mode="Ignore" />
                <ui:Label name="FindMatchSubtitle" class="button-subtitle" text="UNRANKED BOT MATCH" picking-mode="Ignore" />
            </ui:Button>
            <ui:Button name="PracticeButton" class="secondary-button practice-button" text="ENTER PRACTICE   ›" />
            <ui:Label class="match-note" text="Hone your timing. Learn your arsenal." />
        </ui:VisualElement>

        <ui:VisualElement class="hub-footer" picking-mode="Ignore">
            <ui:Label class="footer-brand" text="STEEL. SPELL. SKILL." />
            <ui:Label class="subtle-label" text="DRAG YOUR CHAMPION TO ROTATE" />
            <ui:Label class="subtle-label" text="YOUR NEXT BATTLE STARTS HERE" />
        </ui:VisualElement>

        <ui:VisualElement name="TopBar" class="topbar">
            <ui:Button name="NavPlay" class="brand-block" tooltip="Return to Hub">
                <ui:VisualElement class="brand-mark" picking-mode="Ignore">
                    <ui:VisualElement class="brand-diamond" />
                    <ui:VisualElement class="brand-spear brand-spear--one" />
                    <ui:VisualElement class="brand-spear brand-spear--two" />
                </ui:VisualElement>
                <ui:Label class="brand-word" text="ARENA" picking-mode="Ignore" />
            </ui:Button>
            <ui:VisualElement class="primary-nav">
                <ui:Button name="NavPlayTab" class="nav-item is-active" text="HUB" />
                <ui:Button name="NavDisciplines" class="nav-item " text="DISCIPLINES" />
                <ui:Button name="NavEquipment" class="nav-item " text="EQUIPMENT" />
            </ui:VisualElement>
            <ui:VisualElement class="topbar-tools">
                <ui:Label class="nav-caption" text="PREPARE FOR BATTLE" picking-mode="Ignore" />
                <ui:Button name="SettingsButton" class="tool-button" text="SETTINGS" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="MatchOverlay" class="match-overlay">
            <ui:Button name="OverlayScrim" class="overlay-scrim" />

            <ui:VisualElement class="format-dialog panel-surface">
                <ui:VisualElement class="corner corner--tl" picking-mode="Ignore" />
                <ui:VisualElement class="corner corner--tr" picking-mode="Ignore" />
                <ui:VisualElement class="corner corner--bl" picking-mode="Ignore" />
                <ui:VisualElement class="corner corner--br" picking-mode="Ignore" />
                <ui:VisualElement class="dialog-accent dialog-accent--left" picking-mode="Ignore" />
                <ui:VisualElement class="dialog-accent dialog-accent--right" picking-mode="Ignore" />

                <ui:Button name="DialogClose" class="dialog-close" text="×" />

                <ui:VisualElement class="dialog-heading" picking-mode="Ignore">
                    <ui:Label class="section-kicker" text="PVP MATCH" />
                    <ui:Label class="format-heading" text="CHOOSE YOUR BATTLE" />
                    <ui:VisualElement class="format-description-row">
                        <ui:Label class="format-description" text="Enter an " />
                        <ui:Label name="DialogQueueName" class="format-description format-description--queue" text="Unranked" />
                        <ui:Label class="format-description" text=" bot match." />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="format-options">
                    <ui:Button name="Format2v2" class="format-option is-selected">
                        <ui:VisualElement class="format-copy" picking-mode="Ignore">
                            <ui:Label class="format-name" text="2V2" />
                            <ui:Label class="format-type" text="DUO SKIRMISH" />
                            <ui:Label class="format-note" text="You and an ally dummy against two enemy dummies." />
                        </ui:VisualElement>
                        <ui:Label class="format-check" text="SELECTED" picking-mode="Ignore" />
                    </ui:Button>

                    <ui:Button name="Format3v3" class="format-option format-option--spaced">
                        <ui:VisualElement class="format-copy" picking-mode="Ignore">
                            <ui:Label class="format-name" text="3V3" />
                            <ui:Label class="format-type" text="COMING SOON" />
                            <ui:Label class="format-note" text="Balanced combat for coordinated teams." />
                        </ui:VisualElement>
                        <ui:Label class="format-check" text="SELECTED" picking-mode="Ignore" />
                    </ui:Button>

                    <ui:Button name="Format10v10" class="format-option format-option--spaced">
                        <ui:VisualElement class="format-copy" picking-mode="Ignore">
                            <ui:Label class="format-name" text="10V10" />
                            <ui:Label class="format-type" text="COMING SOON" />
                            <ui:Label class="format-note" text="Large-scale battle. Hold the line." />
                        </ui:VisualElement>
                        <ui:Label class="format-check" text="SELECTED" picking-mode="Ignore" />
                    </ui:Button>
                </ui:VisualElement>

                <ui:VisualElement class="dialog-footer">
                    <ui:VisualElement class="selection-summary" picking-mode="Ignore">
                        <ui:Label class="selection-label" text="YOUR SELECTION" />
                        <ui:Label name="SelectionValue" class="selection-value" text="UNRANKED · 2V2" />
                    </ui:VisualElement>

                    <ui:Button name="QueueConfirm" class="queue-confirm primary-button">
                        <ui:VisualElement class="button-cap button-cap--left" picking-mode="Ignore" />
                        <ui:VisualElement class="queue-confirm-copy" picking-mode="Ignore">
                            <ui:Label class="queue-confirm-title" text="START 2V2 BOT MATCH" />
                            <ui:Label name="QueueConfirmSubtitle" class="queue-confirm-subtitle" text="YOU + AN ALLY DUMMY VS TWO ENEMY DUMMIES" />
                        </ui:VisualElement>
                        <ui:VisualElement class="button-cap button-cap--right" picking-mode="Ignore" />
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
