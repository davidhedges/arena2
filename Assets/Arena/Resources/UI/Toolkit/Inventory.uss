/* Inventory.uss — screen spec for the Inventory/Character/Loot windows.
 * Structural components come from ArenaKit.uss; this file lays out the
 * windows. Twin: docs/ui-prototypes/inventory/. Grid windows are sized by
 * InventoryScreen.cs from server container dimensions:
 *   window width  = cols*68 + 62
 *   window height = 44 + 12 + rows*68 + 36
 * Non-modal: no veil, the game stays visible. */

@import url("ArenaKit.uss");

.inventory-screen {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: none;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    -unity-font-definition: url("/Assets/Arena/Content/UI/Fonts/Alegreya.ttf");
}

.inventory-screen.is-open {
    display: flex;
}

.char-window {
    width: 660px;
    height: 640px;
    margin-right: 16px;
    flex-shrink: 0;
}

.inv-window {
    width: 742px;
    height: 364px;
    flex-shrink: 0;
}

.loot-window {
    width: 380px;
    height: 364px;
    margin-right: 16px;
    display: none;
    flex-shrink: 0;
}

.loot-window.is-open {
    display: flex;
}

/* ---- grid windows: plate + padded grid ------------------------------------ */

.grid-window-content {
    width: 100%;
    padding-top: 12px;
    padding-left: 31px;
    padding-right: 31px;
    padding-bottom: 36px;
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-grow: 1;
}

.grid-items {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}

/* ---- character window: doll + attributes ---------------------------------- */

.char-content {
    width: 100%;
    padding-top: 14px;
    padding-left: 26px;
    padding-right: 26px;
    display: flex;
    flex-direction: row;
    flex-grow: 1;
}

.equip-doll {
    position: relative;
    width: 388px;
    height: 544px;
    flex-shrink: 0;
}

/* Sparse 5x7 doll grid, pitch 78 (76px slot + 2px breathing). */
.equip-slot { position: absolute; }
.equip-slot--head      { left: 156px; top: 0; }
.equip-slot--shoulder  { left: 0;     top: 78px; }
.equip-slot--amulet    { left: 156px; top: 78px; }
.equip-slot--chest     { left: 156px; top: 156px; }
.equip-slot--gloves    { left: 0;     top: 234px; }
.equip-slot--legs      { left: 156px; top: 234px; }
.equip-slot--boots     { left: 156px; top: 312px; }
.equip-slot--ring1     { left: 0;     top: 390px; }
.equip-slot--ring2     { left: 312px; top: 390px; }
.equip-slot--mainhand  { left: 78px;  top: 468px; }
.equip-slot--spellbook { left: 312px; top: 468px; }

/* Padding clears the corner filigree so content never sits under it. */
.stats-panel {
    flex-grow: 1;
    margin-left: 14px;
    height: 544px;
    padding: 32px 24px 24px 24px;
    display: flex;
    flex-direction: column;
}

.stats-panel .section-heading {
    margin-top: 0;
    justify-content: center;
}

.stats-panel .section-rule {
    margin-bottom: 8px;
}

.stats-list {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
}

/* Hidden until the controller drives them (also keeps static previews clean). */
#ItemTooltip,
#DragGhost {
    display: none;
}
