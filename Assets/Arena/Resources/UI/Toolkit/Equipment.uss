/* Collection / live character / details. Lists and details scroll separately. */
.equipment-screen { display: none; padding: 120px 42px 28px; }

.equipment-screen.is-open { display: flex; }

.equipment-veil {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    background-color: rgba(5,12,16,0.28);
}

.equipment-vignette { display: none; }

.equipment-page-heading { margin-bottom: 24px; flex-shrink: 0; }

.equipment-mode-toggle {
    position: absolute;
    right: 0;
    top: 26px;
    flex-direction: row;
    padding: 4px;
    background-color: var(--hub-surface);
    border-width: 1px;
    border-color: var(--hub-line);
    border-radius: 3px;
}

.arena-hub-ui .equipment-mode-button {
    width: 138px;
    height: 42px;
    border-width: 0;
    font-size: 11px;
    letter-spacing: 1.8px;
    color: var(--hub-muted);
}

.arena-hub-ui .equipment-mode-button.is-selected { background-color: var(--hub-brass); color: #161C1E; }

.equipment-columns {
    min-height: 0;
    flex-basis: 0;
    flex-grow: 1;
    flex-direction: row;
    align-items: stretch;
}

.selection-panel {
    width: 25%;
    min-width: 350px;
    flex-shrink: 0;
    padding: 24px;
}

.details-panel {
    width: 26%;
    min-width: 366px;
    flex-shrink: 0;
    padding: 24px;
}

.panel-heading, .set-list-heading {
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-between;
}

.section-heading {
    margin-top: 6px;
    -unity-font-definition: url("/Assets/Arena/Content/UI/Fonts/Cinzel.ttf");
    font-size: 23px;
}

.availability, .set-count {
    color: var(--hub-dim);
    font-size: 9px;
    padding-bottom: 4px;
}

.tier-toggle {
    margin-top: 20px;
    flex-direction: row;
    height: 96px;
    flex-shrink: 0;
}

.arena-hub-ui .tier-button {
    min-width: 0;
    flex-basis: 0;
    flex-grow: 1;
    margin-right: 8px;
    align-items: center;
    justify-content: center;
    background-color: #111B1F;
}

.arena-hub-ui .tier-button--last { margin-right: 0; }

.arena-hub-ui .tier-button.is-selected { border-color: var(--hub-brass); background-color: var(--hub-selected); }

.tier-selected-gem { display: none; }

.tier-glyph {
    color: var(--hub-brass);
    font-size: 27px;
    height: 36px;
}

.tier-name { font-size: 11px; letter-spacing: 1px; }

.tier-note {
    margin-top: 7px;
    color: var(--hub-dim);
    font-size: 9px;
}

.set-list {
    flex-grow: 1;
    flex-basis: 0;
    margin-top: 18px;
}

.arena-hub-ui .set-card {
    min-height: 104px;
    flex-shrink: 0;
    margin-bottom: 10px;
    padding: 16px 12px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    background-color: #121C20;
    border-color: var(--hub-line-soft);
}

.arena-hub-ui .set-card.is-selected, .arena-hub-ui .weapon-card.is-selected { background-color: var(--hub-selected); border-color: var(--hub-brass); }

.set-sigil {
    width: 38px;
    height: 44px;
    flex-shrink: 0;
    margin-right: 14px;
    align-items: center;
    justify-content: center;
    color: var(--hub-brass);
}

.set-sigil-glyph { font-size: 30px; }

.set-copy { min-width: 0; flex-grow: 1; }

.set-meta {
    color: var(--hub-dim);
    font-size: 9px;
    letter-spacing: 0.5px;
}

.set-name {
    margin-top: 7px;
    font-size: 14px;
    white-space: normal;
}

.set-effects {
    margin-top: 7px;
    font-size: 11px;
    color: var(--hub-muted);
    white-space: normal;
}

.set-check {
    margin-left: 10px;
    font-size: 20px;
    color: var(--hub-brass-bright);
}

.whole-set-note {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    margin-top: 16px;
    padding-top: 16px;
    border-top-width: 1px;
    border-top-color: var(--hub-line-soft);
}

.note-glyph {
    font-size: 10px;
    color: var(--hub-brass);
    margin-right: 14px;
}

.note-copy { min-width: 0; flex-grow: 1; }

.note-title {
    color: var(--hub-muted);
    font-size: 10px;
    letter-spacing: 0.7px;
}

.note-body {
    margin-top: 6px;
    color: var(--hub-dim);
    font-size: 12px;
    white-space: normal;
}

.showcase-panel {
    flex-grow: 1;
    min-width: 0;
    margin-left: 16px;
    margin-right: 16px;
}

.arena-hub-ui .showcase-cycle {
    position: absolute;
    top: 45%;
    width: 38px;
    height: 54px;
    font-size: 30px;
    color: var(--hub-brass-bright);
    background-color: rgba(10,18,23,0.65);
    border-color: #4B5553;
}

.showcase-cycle--left { left: 8px; }

.showcase-cycle--right { right: 8px; }

.showcase-caption {
    position: absolute;
    bottom: 24px;
    left: 20px;
    right: 20px;
    align-items: center;
    padding: 18px;
    background-color: rgba(10,18,23,0.88);
    border-top-width: 1px;
    border-top-color: #68706A;
}

.showcase-tier {
    font-size: 10px;
    letter-spacing: 2px;
    color: var(--hub-brass);
}

.showcase-name {
    margin-top: 8px;
    -unity-font-definition: url("/Assets/Arena/Content/UI/Fonts/Cinzel.ttf");
    font-size: 27px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.showcase-help {
    margin-top: 12px;
    color: var(--hub-dim);
    font-size: 9px;
    letter-spacing: 1px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.details-scroll {
    flex-grow: 1;
    flex-basis: 0;
    margin-bottom: 20px;
}

.details-name {
    margin-top: 12px;
    -unity-font-definition: url("/Assets/Arena/Content/UI/Fonts/Cinzel.ttf");
    font-size: 28px;
    white-space: normal;
}

.details-flavor {
    margin-top: 14px;
    color: var(--hub-muted);
    font-size: 14px;
    white-space: normal;
}

.protection-summary, .weapon-summary {
    margin-top: 24px;
    margin-bottom: 24px;
    padding: 16px 0;
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-color: var(--hub-line);
    border-bottom-color: var(--hub-line);
}

.summary-emblem {
    width: 36px;
    height: 36px;
    margin-right: 14px;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: var(--hub-brass);
    font-size: 26px;
}

.summary-copy { min-width: 0; flex-grow: 1; }

.summary-tier { font-size: 11px; letter-spacing: 1px; }

.summary-headline {
    margin-top: 6px;
    font-size: 9px;
    color: var(--hub-dim);
    white-space: normal;
}

.equipped-chip {
    padding: 5px 7px;
    margin-left: 8px;
    margin-top: 5px;
    border-width: 1px;
    border-color: #526458;
    color: var(--hub-success);
    font-size: 8px;
}

.effect-heading {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 8px;
    color: var(--hub-brass);
    font-size: 10px;
    letter-spacing: 1px;
}

.effect-heading--tradeoffs { margin-top: 24px; }

.effect-row, .weapon-loadout-row {
    min-height: 74px;
    flex-direction: row;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: var(--hub-line-soft);
}

.effect-icon {
    width: 28px;
    font-size: 19px;
    color: var(--hub-dim);
    flex-shrink: 0;
}

.effect-copy { flex-grow: 1; min-width: 0; }

.effect-title {
    font-size: 10px;
    letter-spacing: 0.5px;
    white-space: normal;
}

.effect-description {
    margin-top: 6px;
    font-size: 12px;
    color: var(--hub-dim);
    white-space: normal;
}

.effect-value {
    font-size: 26px;
    margin-left: 10px;
    color: var(--hub-success);
}

.effect-row--negative .effect-value { color: #D0A092; }

.no-tradeoffs {
    display: none;
    padding: 16px 0;
    color: var(--hub-success);
    font-size: 12px;
    white-space: normal;
}

.no-tradeoffs.is-visible { display: flex; }

.loadout-meta {
    margin-top: 24px;
    flex-direction: row;
    padding: 18px 0;
}

.loadout-meta-block { flex-grow: 1; }

.meta-label {
    color: var(--hub-dim);
    font-size: 9px;
    letter-spacing: 1px;
}

.meta-value { margin-top: 7px; font-size: 11px; }

.arena-hub-ui .equip-button.is-equipped {
    background-color: #293A30;
    border-color: #657C67;
    color: var(--hub-success);
}

.equipment-panel-hidden, .is-hidden { display: none; }

.weapon-list {
    flex-grow: 1;
    flex-basis: 0;
    margin-top: 14px;
    min-height: 100px;
}

.weapon-list--offhand {
    height: 160px;
    flex-grow: 0;
    flex-basis: auto;
}

.weapon-section-rule { margin-top: 18px; margin-bottom: 18px; }

.arena-hub-ui .weapon-card {
    min-height: 82px;
    flex-shrink: 0;
    margin-bottom: 8px;
    padding: 12px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    background-color: #121C20;
}

.weapon-card-icon {
    width: 48px;
    height: 48px;
    margin-right: 14px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.weapon-card-copy { min-width: 0; flex-grow: 1; }

.weapon-card-name { font-size: 13px; white-space: normal; }

.weapon-card-meta {
    margin-top: 6px;
    color: var(--hub-dim);
    font-size: 10px;
    white-space: normal;
}

.weapon-card-check {
    margin-left: 8px;
    font-size: 19px;
    color: var(--hub-brass);
}

.weapon-details-spacer { display: none; }

.weapon-details-icon {
    width: 72px;
    height: 72px;
    margin-top: 16px;
    -unity-background-scale-mode: scale-to-fit;
}

.weapon-color-section { margin-top: 24px; }

.weapon-color-list {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 12px;
}

.arena-hub-ui .weapon-color-button {
    width: 38px;
    height: 38px;
    margin-right: 10px;
    margin-bottom: 10px;
    border-width: 3px;
    border-color: #243137;
    border-radius: 20px;
}

.arena-hub-ui .weapon-color-button.is-selected { border-color: var(--hub-brass-bright); }

.weapon-rule-card {
    margin-top: 20px;
    padding: 18px;
    background-color: #121C20;
    border-left-width: 2px;
    border-left-color: #68706A;
}

.prototype-toast {
    position: absolute;
    bottom: 30px;
    left: 30%;
    right: 30%;
    display: none;
    padding: 18px 24px;
    background-color: #23322B;
    border-width: 1px;
    border-color: #77917C;
    color: var(--hub-text);
    font-size: 14px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.prototype-toast.is-visible { display: flex; }

/* Roman protection classes use the display face; effect labels carry meaning. */
.tier-glyph, .set-sigil-glyph, .summary-emblem { -unity-font-definition: url("/Assets/Arena/Content/UI/Fonts/Cinzel.ttf"); }

.effect-icon { display: none; }

.note-glyph { -unity-font-definition: url("/Assets/Arena/Content/UI/Fonts/Alegreya.ttf"); }
