/* Character-first landing screen. The scene camera supplies the backdrop. */
.hub-background-veil {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    background-color: rgba(6,12,16,0.24);
}

.hub-floor-shade {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 88px;
    background-color: rgba(8,14,17,0.9);
}

.showcase {
    position: absolute;
    top: 100px;
    bottom: 90px;
    left: 28%;
    right: 28%;
}

.profile-panel {
    position: absolute;
    top: 24%;
    left: 42px;
    width: 22%;
    padding: 28px;
}

.profile-name {
    margin-top: 12px;
    -unity-font-definition: url("/Assets/Arena/Content/UI/Fonts/Cinzel.ttf");
    font-size: 30px;
    white-space: normal;
}

.profile-subtitle {
    margin-top: 12px;
    color: var(--hub-muted);
    font-size: 14px;
    white-space: normal;
}

.profile-loadout-heading {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.loadout-list { margin-top: 16px; }

.loadout-row {
    min-height: 88px;
    flex-direction: row;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: var(--hub-line-soft);
}

.loadout-icon {
    width: 52px;
    height: 52px;
    margin-right: 16px;
    flex-shrink: 0;
    border-width: 1px;
    border-radius: 2px;
    background-color: #111A1E;
}

.loadout-art {
    position: absolute;
    top: 4px;
    left: 4px;
    right: 4px;
    bottom: 4px;
    -unity-background-scale-mode: scale-to-fit;
}

.loadout-glyph {
    flex-grow: 1;
    font-size: 22px;
    color: var(--hub-muted);
    -unity-text-align: middle-center;
}

.loadout-copy { flex-grow: 1; min-width: 0; }

.loadout-type {
    color: var(--hub-dim);
    font-size: 9px;
    letter-spacing: 1px;
}

.loadout-name {
    margin-top: 6px;
    font-size: 14px;
    letter-spacing: 0.5px;
    white-space: normal;
}

.loadout-index {
    color: var(--hub-dim);
    font-size: 10px;
    margin-left: 10px;
}

.arena-hub-ui .profile-edit {
    margin-top: 24px;
    font-size: 10px;
    padding-left: 8px;
    padding-right: 8px;
}

.match-panel {
    position: absolute;
    top: 24%;
    right: 42px;
    width: 22%;
    padding: 28px;
}

.match-title {
    margin-top: 18px;
    -unity-font-definition: url("/Assets/Arena/Content/UI/Fonts/Cinzel.ttf");
    font-size: 46px;
    white-space: normal;
}

.match-subtitle {
    margin-top: 18px;
    color: var(--hub-muted);
    font-size: 15px;
    white-space: normal;
}

.hub-screen .queue-summary {
    min-height: 60px;
    border-width: 0;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.hub-screen .queue-summary:disabled { opacity: 1; }

.queue-name {
    font-size: 15px;
    letter-spacing: 1px;
    margin-top: 7px;
}

.queue-tag { color: var(--hub-brass); font-size: 10px; }

.hub-screen .match-button { height: 76px; margin-top: 22px; }

.button-title {
    font-size: 17px;
    letter-spacing: 2px;
    color: #141C1F;
}

.button-subtitle {
    margin-top: 7px;
    font-size: 9px;
    letter-spacing: 1.3px;
    color: #3C423C;
}

.hub-screen .practice-button { margin-top: 12px; font-size: 11px; }

.match-note {
    margin-top: 16px;
    color: var(--hub-dim);
    font-size: 11px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.hub-footer {
    position: absolute;
    left: 42px;
    right: 42px;
    bottom: 0;
    height: 88px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    border-top-width: 1px;
    border-top-color: var(--hub-line);
}

.footer-brand {
    -unity-font-definition: url("/Assets/Arena/Content/UI/Fonts/Cinzel.ttf");
    font-size: 14px;
    letter-spacing: 2px;
    color: var(--hub-brass);
}

.match-overlay {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    display: none;
    align-items: center;
    justify-content: center;
}

.match-overlay.is-open { display: flex; }

.arena-hub-ui .overlay-scrim {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    background-color: rgba(3,8,11,0.88);
    border-width: 0;
}

.format-dialog {
    width: 1080px;
    max-width: 90%;
    padding: 44px;
    border-color: #68706A;
}

.arena-hub-ui .dialog-close {
    position: absolute;
    top: 22px;
    right: 22px;
    width: 36px;
    height: 36px;
    font-size: 23px;
}

.format-heading {
    -unity-font-definition: url("/Assets/Arena/Content/UI/Fonts/Cinzel.ttf");
    margin-top: 14px;
    font-size: 32px;
}

.format-description-row { margin-top: 14px; flex-direction: row; }

.format-description { font-size: 15px; color: var(--hub-muted); }

.format-description--queue { color: var(--hub-brass); }

.format-options { flex-direction: row; margin-top: 32px; }

.arena-hub-ui .format-option {
    height: 190px;
    flex-basis: 0;
    flex-grow: 1;
    min-width: 0;
    padding: 24px;
    align-items: stretch;
    justify-content: center;
}

.arena-hub-ui .format-option--spaced { margin-left: 16px; }

.arena-hub-ui .format-option.is-selected { background-color: var(--hub-selected); border-color: var(--hub-brass); }

.format-name {
    -unity-font-definition: url("/Assets/Arena/Content/UI/Fonts/Cinzel.ttf");
    font-size: 42px;
    color: var(--hub-brass-bright);
}

.format-type {
    margin-top: 8px;
    font-size: 11px;
    letter-spacing: 1px;
}

.format-note {
    margin-top: 12px;
    font-size: 13px;
    color: var(--hub-muted);
    white-space: normal;
}

.format-check {
    font-size: 9px;
    position: absolute;
    top: 20px;
    right: 20px;
    color: var(--hub-brass);
    display: none;
}

.format-option.is-selected .format-check { display: flex; }

.dialog-footer {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-top: 32px;
    padding-top: 28px;
    border-top-width: 1px;
    border-top-color: var(--hub-line);
}

.selection-label {
    color: var(--hub-dim);
    font-size: 10px;
    letter-spacing: 1.5px;
}

.selection-value { margin-top: 8px; font-size: 15px; }

.arena-hub-ui .queue-confirm { width: 440px; min-height: 76px; }

.queue-confirm-copy { align-items: center; }

.queue-confirm-title {
    color: #141C1F;
    font-size: 14px;
    letter-spacing: 1px;
}

.queue-confirm-subtitle {
    color: #3C423C;
    max-width: 400px;
    margin-top: 7px;
    font-size: 10px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.hub-screen .match-button.is-searching { background-color: #8A8068; }

.hub-screen .queue-copy { -unity-text-align: middle-left; }
