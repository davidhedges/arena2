<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="HubCommon.uss" />
    <Style src="Disciplines.uss" />

    <ui:VisualElement name="DisciplinesScreen" class="arena-hub-ui disciplines-screen">
        <ui:VisualElement class="screen-background" picking-mode="Ignore" />
        <ui:VisualElement class="screen-veil" picking-mode="Ignore" />
        <ui:VisualElement class="screen-vignette" picking-mode="Ignore" />

        <ui:VisualElement name="TopBar" class="topbar">
            <ui:Button name="NavPlay" class="brand-block" tooltip="Return to Hub">
                <ui:VisualElement class="brand-mark" picking-mode="Ignore">
                    <ui:VisualElement class="brand-diamond" />
                    <ui:VisualElement class="brand-spear brand-spear--one" />
                    <ui:VisualElement class="brand-spear brand-spear--two" />
                </ui:VisualElement>
                <ui:Label class="brand-word" text="ARENA" picking-mode="Ignore" />
            </ui:Button>
            <ui:VisualElement class="primary-nav">
                <ui:Button name="NavPlayTab" class="nav-item " text="HUB" />
                <ui:Button name="NavDisciplines" class="nav-item is-active" text="DISCIPLINES" />
                <ui:Button name="NavEquipment" class="nav-item " text="EQUIPMENT" />
            </ui:VisualElement>
            <ui:VisualElement class="topbar-tools">
                <ui:Label class="nav-caption" text="PREPARE FOR BATTLE" picking-mode="Ignore" />
                <ui:Button name="SettingsButton" class="tool-button" text="SETTINGS" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="build-heading">
            <ui:VisualElement class="build-heading-copy" picking-mode="Ignore">
                <ui:Label class="heading-kicker" text="COMBAT LOADOUT" />
                <ui:Label class="page-title" text="Disciplines" />
                <ui:Label class="page-subtitle" text="Choose your paths. Make them your own." />
            </ui:VisualElement>
            <ui:VisualElement class="allocation-panel">
                <ui:VisualElement class="allocation-item"><ui:Label name="ActiveAllocation" class="allocation-value allocation-value--active" text="—" /><ui:Label class="allocation-label" text="ACTIVE" /></ui:VisualElement>
                <ui:VisualElement class="allocation-divider" />
                <ui:VisualElement class="allocation-item"><ui:Label name="TotalAllocation" class="allocation-value" text="—" /><ui:Label class="allocation-label" text="FEATURE CAPACITY" /></ui:VisualElement>
                <ui:VisualElement class="allocation-divider" />
                <ui:VisualElement class="allocation-item"><ui:Label name="DisciplineAllocation" class="allocation-value allocation-value--disciplines" text="—" /><ui:Label class="allocation-label" text="FORMS · SCHOOLS" /></ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="loadout-overview panel-surface">
            <ui:VisualElement class="overview-heading" picking-mode="Ignore">
                <ui:VisualElement>
                    <ui:Label class="section-kicker" text="01 / YOUR PATHS" />
                    <ui:Label class="overview-title" text="Forms &amp; schools" />
                </ui:VisualElement>
                <ui:Label class="overview-help" text="SELECT A PATH TO EDIT ITS ABILITIES" />
            </ui:VisualElement>
            <ui:VisualElement name="DisciplineCards" class="discipline-cards" />
        </ui:VisualElement>

        <ui:VisualElement class="trait-strip panel-surface">
            <ui:VisualElement class="trait-heading" picking-mode="Ignore">
                <ui:Label class="section-kicker" text="02 / YOUR EDGE" />
                <ui:Label class="trait-title" text="Traits" />
            </ui:VisualElement>
            <ui:VisualElement name="TraitOptions" class="trait-options" />
        </ui:VisualElement>

        <ui:VisualElement class="configuration-shell">
            <ui:ScrollView name="SpecializationEditor" class="specialization-editor panel-surface" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto" />

            <ui:VisualElement class="build-footer panel-surface">
                <ui:VisualElement class="save-heading" picking-mode="Ignore">
                    <ui:Label class="section-kicker" text="READY YOUR BUILD" />
                    <ui:Label class="save-title" text="The final word" />
                </ui:VisualElement>
                <ui:ScrollView name="SaveSummary" class="save-summary" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto" />
                <ui:Label name="SaveStatus" class="save-status" text="Waiting for your combat build." />
                <ui:VisualElement class="footer-actions">
                    <ui:Button name="SaveBuild" class="save-button primary-button" text="SAVE LOADOUT" />
                    <ui:Button name="BackButton" class="back-button" text="BACK TO HUB" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="PickerOverlay" class="picker-overlay">
            <ui:Button name="PickerScrim" class="picker-scrim" />
            <ui:VisualElement class="picker-panel">
                <ui:VisualElement class="picker-heading">
                    <ui:VisualElement class="picker-heading-copy" picking-mode="Ignore">
                        <ui:Label name="PickerTitle" class="picker-title" text="Choose your discipline" />
                        <ui:Label name="PickerSubtitle" class="picker-subtitle" />
                    </ui:VisualElement>
                    <ui:Button name="PickerClose" class="picker-close" text="×" tooltip="Close picker" />
                </ui:VisualElement>
                <ui:VisualElement class="picker-steps" picking-mode="Ignore">
                    <ui:Label name="PickerDisciplineStep" class="picker-step is-current" text="01  WEAPON / SPELLCASTING" />
                    <ui:VisualElement class="picker-step-line" />
                    <ui:Label name="PickerSpecializationStep" class="picker-step" text="02  FORM / SCHOOL" />
                </ui:VisualElement>
                <ui:VisualElement name="PickerOptions" class="picker-options" />
                <ui:VisualElement class="picker-footer">
                    <ui:Button name="PickerBack" class="picker-back" text="CANCEL" />
                    <ui:Label name="PickerHint" class="picker-hint" text="Choose a discipline to explore its forms or schools." picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
