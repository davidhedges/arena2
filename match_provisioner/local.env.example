# This file contains configuration only. Never commit a real bearer token.
ARENA_PROVISIONER_MANAGEMENT_URL=http://127.0.0.1:3000
ARENA_PROVISIONER_CLIENT_URI=ws://127.0.0.1:3000
ARENA_PROVISIONER_HUB_DATABASE=arena-hub-local
ARENA_PROVISIONER_DATABASE_PREFIX=arena-match
ARENA_PROVISIONER_MAP_ID=ARENA_MAP_01
ARENA_PROVISIONER_MATCH_WASM=match-server/target/wasm32-unknown-unknown/release/arena_match.opt.wasm
# Disposable open worlds publish the MAIN server module: the PvP flavor compiles
# every open-world reducer out. Their destination comes from the ticket, not
# from ARENA_PROVISIONER_MAP_ID, which stays the PvP arena map.
ARENA_PROVISIONER_OPENWORLD_WASM=server/target/wasm32-unknown-unknown/release/arena.opt.wasm
ARENA_PROVISIONER_STATE_DB=Library/ArenaMatchProvisioner/state.sqlite3

# Circuit breakers and lifecycle bounds.
ARENA_PROVISIONER_MAX_CONCURRENT_MATCHES=4
ARENA_PROVISIONER_LEASE_SECONDS=90
ARENA_PROVISIONER_ALLOCATION_SECONDS=120
ARENA_PROVISIONER_HARD_TTL_SECONDS=1800
# Event wakeups handle new work; this slower sweep recovers missed events,
# restarts, lease retries, match completion, and cleanup.
ARENA_PROVISIONER_RECONCILE_SECONDS=30
ARENA_PROVISIONER_CLEANUP_RETRY_SECONDS=5
ARENA_PROVISIONER_CLEANED_RETENTION_SECONDS=86400

# Required when invoking the Python module directly. The local runner obtains
# the currently logged-in CLI token without printing it when this is unset.
# ARENA_PROVISIONER_TOKEN=
